# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: API key for the Resend email-delivery service
RESEND_API_KEY="re_123456789"

# ENQUIRY_FROM_EMAIL: Verified sender email address (e.g. enquiries@vsrpt.com)
ENQUIRY_FROM_EMAIL="enquiries@vsrpt.com"

# ENQUIRY_TO_EMAIL: Receiving email address for website enquiries
ENQUIRY_TO_EMAIL="prekshathakker57@gmail.com"

# TWILIO_ACCOUNT_SID: Your Twilio Account SID for WhatsApp notifications
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# TWILIO_AUTH_TOKEN: Your Twilio Auth Token
TWILIO_AUTH_TOKEN="your_twilio_auth_token"

# TWILIO_WHATSAPP_FROM: Your Twilio WhatsApp sender number (e.g. whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# INSTITUTE_WHATSAPP_TO: The institute's destination WhatsApp number (e.g. whatsapp:+919876543210)
INSTITUTE_WHATSAPP_TO="whatsapp:+919876543210"

# APPS_SCRIPT_URL: Google Apps Script Web App URL for Google Sheets backend integration
APPS_SCRIPT_URL=""
VITE_APPS_SCRIPT_URL=""
